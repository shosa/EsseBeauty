# Ambiente di sviluppo locale per processi avviati sul computer host.
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0

# Origini browser autorizzate a chiamare l'API con credenziali. Separare con virgole.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false

# Connessioni dal computer host. I container Docker usano invece db:5432 e redis:6379.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esse_beauty
REDIS_URL=redis://localhost:6380
POSTGRES_DB=esse_beauty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-questa-password-in-produzione
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres
REDIS_PORT=6380
API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002
STAFF_PWA_PORT=3003
PLATFORM_PORT=3004

# Segreti obbligatori. Generare due valori diversi con:
# node -e "const {randomBytes}=require('node:crypto'); console.log(randomBytes(32).toString('hex'))"
REVIEW_TOKEN_SECRET=sostituisci-con-almeno-32-caratteri-casuali
REVIEW_SESSION_SECRET=sostituisci-con-un-altro-segreto-casuale-diverso

# URL server-side usati dai job API e dalle chiamate interne.
API_INTERNAL_URL=http://localhost:3001
PWA_URL=http://localhost:3002

# URL pubblici incorporati nelle app Next.js durante la build.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3002

# Provider email e WhatsApp opzionali.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Obbligatoria prima di salvare credenziali provider. Generare con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
