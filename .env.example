# Local development environment for host-run processes.
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0

# Browser origins allowed to call the API with credentials. Keep this comma-separated.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false

# Host connections. Docker services use db:5432 and redis:6379 instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esse_beauty
REDIS_URL=redis://localhost:6380

# Required secrets. Generate two different values with:
# node -e "const {randomBytes}=require('node:crypto'); console.log(randomBytes(32).toString('hex'))"
REVIEW_TOKEN_SECRET=replace-with-at-least-32-random-characters
REVIEW_SESSION_SECRET=replace-with-another-32-character-random-secret

# Server-side URLs used by API jobs and internal calls.
API_INTERNAL_URL=http://localhost:3001
PWA_URL=http://localhost:3002

# Public URLs baked into Next.js apps at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3002

# Optional email and WhatsApp providers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Required before storing provider credentials. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
