# Ambiente di sviluppo locale per processi avviati sul computer host.
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0

# Origini browser autorizzate a chiamare l'API con credenziali. Separare con virgole.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false

# Connessioni dal computer host. I container Docker usano invece db:5432 e redis:6379.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esse_beauty
REDIS_URL=redis://localhost:6380
POSTGRES_DB=esse_beauty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-questa-password-in-produzione
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres
REDIS_PORT=6380

# Abilita il container nginx gateway locale. In VPS, dove nginx gira sul sistema
# host, lasciare vuoto: COMPOSE_PROFILES=
COMPOSE_PROFILES=gateway

API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002
STAFF_PWA_PORT=3003
PLATFORM_PORT=3004
WEBSITE_PORT=3005

# Porte pubblicate solo su 127.0.0.1 per nginx systemwide o diagnostica host.
# Non entrano in conflitto con API_PORT, usato dal gateway locale.
API_UPSTREAM_PORT=3011
COMMUNICATIONS_UPSTREAM_PORT=3013
LOYALTY_MARKETING_UPSTREAM_PORT=3016
BOOKING_UPSTREAM_PORT=3017
COMMERCE_UPSTREAM_PORT=3018
IDENTITY_UPSTREAM_PORT=3019

# Endpoint interni usati dall'API per la pagina Stato servizi.
# In Docker devono puntare ai nomi dei servizi sulla rete app, non alle porte host 301x.
PLATFORM_API_HEALTH_URL=http://127.0.0.1:3001/health
PLATFORM_COMMUNICATIONS_HEALTH_URL=http://communications:3003/health
PLATFORM_LOYALTY_MARKETING_HEALTH_URL=http://loyalty-marketing:3006/health
PLATFORM_BOOKING_HEALTH_URL=http://booking:3007/health
PLATFORM_COMMERCE_HEALTH_URL=http://commerce:3008/health
PLATFORM_IDENTITY_HEALTH_URL=http://identity:3009/health

# Segreti obbligatori. Generare due valori diversi con:
# node -e "const {randomBytes}=require('node:crypto'); console.log(randomBytes(32).toString('hex'))"
REVIEW_TOKEN_SECRET=sostituisci-con-almeno-32-caratteri-casuali
REVIEW_SESSION_SECRET=sostituisci-con-un-altro-segreto-casuale-diverso

# URL server-side usati dai processi avviati direttamente sull'host.
API_INTERNAL_URL=http://localhost:3001
PWA_URL=http://localhost:3002

# URL server-side iniettato nel container PWA. In locale passa dal gateway
# Docker; in VPS senza gateway puntarlo al dominio API servito da nginx host.
PWA_API_INTERNAL_URL=http://gateway:3001

# URL pubblici incorporati nelle app Next.js durante la build.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3002
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3004
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Mail di contatto per sito
NEXT_PUBLIC_BUSINESS_EMAIL=

# Provider email e WhatsApp opzionali.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Obbligatoria prima di salvare credenziali provider. Generare con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_KEY_VERSION=v1

# Push notifications ai clienti dalla PWA (Web Push). Generare la coppia con:
# npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:support@essebeauty.app
