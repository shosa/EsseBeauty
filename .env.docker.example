# Ambiente Docker Compose. Copiare questo file in .env.docker.

# Impostazioni del container PostgreSQL. Su un volume gia esistente, POSTGRES_DB
# non viene ricreato automaticamente: il servizio migrate lo crea prima di Drizzle.
POSTGRES_DB=esse_beauty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-questa-password-in-produzione
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres

# Porte pubblicate sul computer host.
REDIS_PORT=6380
API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002
STAFF_PWA_PORT=3003
PLATFORM_PORT=3004

# Default Docker locale. In produzione HTTPS impostare COOKIE_SECURE=true e
# sostituire ogni URL localhost con l'origine pubblica servita dal reverse proxy.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3002
PWA_URL=http://localhost:3002

# Obbligatori. Generare due valori distinti come documentato in DOCKER.md.
# I valori vuoti fanno fermare intenzionalmente Docker Compose prima dell'avvio.
REVIEW_TOKEN_SECRET=
REVIEW_SESSION_SECRET=

# Provider email e WhatsApp opzionali.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Obbligatoria prima di salvare credenziali provider. Generare come documentato in DOCKER.md.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
