# Docker Compose environment. Copy this file to .env.docker.

# PostgreSQL container settings. On an existing volume, POSTGRES_DB is not
# recreated automatically; the migrate service creates it before Drizzle runs.
POSTGRES_DB=esse_beauty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres

# Published host ports.
REDIS_PORT=6380
API_PORT=3001
WEB_PORT=3000
PWA_PORT=3002
STAFF_PWA_PORT=3003
PLATFORM_PORT=3004

# Local Docker defaults. In HTTPS production set COOKIE_SECURE=true and replace
# every localhost URL with the public origin served by your reverse proxy.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3002
PWA_URL=http://localhost:3002

# Required. Generate two distinct values as documented in DOCKER.md.
# Empty values intentionally make Docker Compose stop before startup.
REVIEW_TOKEN_SECRET=
REVIEW_SESSION_SECRET=

# Optional email and WhatsApp providers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Required before storing provider credentials. Generate as documented in DOCKER.md.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
